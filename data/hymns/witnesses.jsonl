{"address": "wh-ZKZJZE0AY1/la.1", "passage_uid": "wh-ZKZJZE0AY1", "name": "la.1", "lang": "la", "role": "original", "register": "medieval-latin", "text": "Quem in mundi pretium\nFructus ventris generosi\nRex effudit gentium.", "generated": false, "source": "roman-missal-received", "attested": "Y", "reading_of_record": true, "cut_from": "wh-AXB3RQ4Y1N/la.1"}
