__pycache__/
*.pyc
.DS_Store
Thumbs.db
data/corpus/
data/books/*.json
!data/books/manifest.json
data/markdown/

# Identity is NOT derived and NOT rebuildable. data/uids/ is the single home
# for the citation -> uid map and its tombstones; losing it silently renames
# every identifier in the Word Hoard. Never ignore it, and never regenerate it
# from scratch -- a build that mints where it should reuse is a bug, not a
# refresh. See pipeline/wh_uid.py.
!data/uids/
!data/uids/*.json

# Whitaker lemma table: rebuildable from the pinned files (build_lemma_spine.py);
# its sha256 is in data/lemmas/whitaker-la/manifest.json. The hymn slice is committed.
data/lemmas/whitaker-la/lemmas.jsonl

# The reader (pipeline/render_reader.py) is generated; rebuild, never commit.
build/

# The Bible JSONL shards are rebuilt from pinned sources, not committed
# (pipeline/rebuild_bible.py: under a minute, byte-identical). What stays
# committed: each manifest.json, which carries every shard's sha256 so
# `--check` proves a rebuild equals the published data; the NT's house inputs
# (gloss-overrides, prose-order) and their .prov.md; and John, which the review
# sheets and the reader read, so Adam's review loop needs no fetch.
data/nt/*/*.jsonl
!data/nt/John/*.jsonl
data/ot/*/*.jsonl
